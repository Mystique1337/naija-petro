# ==========================================================================
# Naija-Petro — environment template.  Copy to .env and fill in.
#   cp .env.example .env
# NEVER commit .env (it is gitignored).
# ==========================================================================

# --- Hugging Face (write token, used by scripts/push_cards.py) ---
HF_TOKEN=

# --- Model serving (Modal) ---
# The fine-tuned model pulled from the Hub for vLLM serving.
MODEL_REPO=Shinzmann/naija-petro-8b
# GPU type for the 8B model on Modal (L4 is cheapest 24GB that fits the 8B; A10G is faster).
LLM_GPU=L4
# Seconds an idle GPU container stays warm before scaling to zero.
# Lower = cheaper (less idle GPU billing), but more cold starts.
LLM_SCALEDOWN_WINDOW=120
# Max sequence / context length.
MAX_MODEL_LEN=8192

# --- Embeddings ---
EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBED_DIM=768
# Embeddings run on CPU by default (no second GPU). Set EMBED_GPU=L4 only if you
# turn the cross-encoder reranker back on and want it fast.
EMBED_GPU=

# --- Reranker (off by default: CPU reranking is slow; hybrid RRF already strong).
#     To enable: ENABLE_RERANK=1 and ideally EMBED_GPU=L4. ---
ENABLE_RERANK=0
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- Self-hosted Supabase (pgvector vector store) ---
# The running app talks to Supabase over the REST (PostgREST) API, so these two
# are the ones it actually needs. The service-role key is server-side only.
SUPABASE_URL=https://your-supabase-host
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Direct Postgres URL. NOT used by the app: only for applying schema.sql with
# psql and for the offline admin scripts (scripts/seed_tokens.py).
SUPABASE_DB_URL=postgresql://postgres:password@your-supabase-host:5432/postgres
# Schema the RAG tables/functions live in. On a shared self-hosted Supabase each
# app gets its own schema; leave as public for a single-tenant Postgres.
SUPABASE_DB_SCHEMA=naija_petro

# --- Web search (Tavily, primary retriever for fresh Nigerian sources) ---
TAVILY_API_KEY=

# --- Langfuse (prompt + RAG tracing) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Dynamic RAG tuning ---
# Below this top similarity (0-1) we treat local coverage as weak and fetch live.
RAG_COVERAGE_THRESHOLD=0.55
# Minimum local chunks before we consider coverage adequate.
RAG_MIN_CHUNKS=3
# Retrieval breadth: candidates pulled, sources kept for the answer, and the
# context character budget (raise these to show more sources, at a little more cost).
RAG_TOP_K=35
RAG_FINAL_K=12
RAG_CONTEXT_CHARS=20000
# Run a background enrichment job after every query (1) or only when weak (0).
RAG_ALWAYS_ENRICH=1
# Days before a web-sourced chunk is considered stale.
RAG_DOC_TTL_DAYS=30

# --- Corpus-builder notebook keys (only if you re-run 01_corpus_builder.ipynb) ---
S2_API_KEY=
NVIDIA_API_KEY=
CORE_API_KEY=
EIA_API_KEY=
POLITE_EMAIL=you@example.com
